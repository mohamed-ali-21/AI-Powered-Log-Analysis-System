{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "LogMindDb": "Server=localhost\\SQLEXPRESS;Database=LogMindDb;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },
  "LogProcessing": {
    "IntervalSeconds": 30,
    "BatchSize": 100
  },
  "IssueAnalysis": {
    "IntervalSeconds": 30,
    "BatchSize": 20,
    "DelayBetweenCallsMs": 250,
    "HealthCheckEnabled": true,
    "DefaultAgent": "logmind",
    "Agents": {
      "logmind": {
        "BaseUrl": "http://localhost:8000",
        "AppName": "logmind_agent",
        "UserId": "logmind-worker",
        "ListAppsPath": "/list-apps",
        "RunPath": "/run",
        "RequestTimeoutSeconds": 90,
        "MaxRetries": 3
      }
    }
  }
}
